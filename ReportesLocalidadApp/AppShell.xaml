<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ReportesLocalidadApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ReportesLocalidadApp.Views"
    FlyoutBehavior="Disabled"
    Title="Ciudad Activa">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginView}"
        Route="login" />

    <ShellContent
        Title="Reportes"
        ContentTemplate="{DataTemplate views:InicioView}"
        Route="reportes" />

    <ShellContent
        Title="Admin"
        ContentTemplate="{DataTemplate views:ReportesAdminView}"
        Route="adminReportes" />

</Shell>
