<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ReportesLocalidadApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ReportesLocalidadApp.Views"
    FlyoutBehavior="Disabled"
    Title="Ciudad Activa">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginView}"
        Route="login" />

    <ShellContent
        Title="Inicio"
        ContentTemplate="{DataTemplate views:InicioView}"
        Route="reportes" />

    <ShellContent
        Title="Agregar"
        ContentTemplate="{DataTemplate views:AgregarReporteView}"
        Route="agregarReporte" />

    <ShellContent
        Title="Mis reportes"
        ContentTemplate="{DataTemplate views:MisReportesView}"
        Route="misReportes" />

    <ShellContent
        Title="Perfil"
        ContentTemplate="{DataTemplate views:PerfilView}"
        Route="perfil" />

    <ShellContent
        Title="Administrador"
        ContentTemplate="{DataTemplate views:ReportesAdminView}"
        Route="adminReportes" />

</Shell>
