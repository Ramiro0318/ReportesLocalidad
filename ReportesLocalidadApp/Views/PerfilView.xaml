<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ReportesLocalidadApp.Views.PerfilView"
             Title="PerfilView" Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="auto,auto,*" BackgroundColor="#0F0F0F">
        <VerticalStackLayout Grid.Row="0">
            <VerticalStackLayout.Background>
                <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                    <GradientStop Color="#f05a3c" Offset="0.1"></GradientStop>
                    <GradientStop Color="#F54927" Offset="0.8"></GradientStop>
                </LinearGradientBrush>
            </VerticalStackLayout.Background>
            <Image Source="perfil.png" HeightRequest="70" WidthRequest="70"></Image>
            <Label Text="Carlos Hernandez"  VerticalTextAlignment="Center" Grid.Row="0" Grid.Column="1" HorizontalTextAlignment="Center" TextColor="White" FontSize="20" FontAttributes="Bold"></Label>
        </VerticalStackLayout>

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Margin="10,10,10,0" ColumnSpacing="10">
            <Border BackgroundColor="#2B2B29"
                    Stroke="#4A4A45" StrokeThickness="1"                                        
                    StrokeShape="RoundRectangle 15">

                <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                    <Label Text="12" TextColor="White" FontSize="22"
                           FontAttributes="Bold" HorizontalTextAlignment="Center"></Label>

                    <Label Text="Reportes" TextColor="White" FontSize="12"
                           HorizontalTextAlignment="Center"></Label>
                </VerticalStackLayout>
            </Border>
            
            <Border BackgroundColor="#2B2B29" Grid.Column="1"
              Stroke="#4A4A45" StrokeThickness="1" Padding="12" HeightRequest="80"
              StrokeShape="RoundRectangle 14">

                <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                    <Label Text="4" TextColor="White" FontSize="22" FontAttributes="Bold" HorizontalTextAlignment="Center"></Label>
                    <Label Text="Atendidos" TextColor="White" FontSize="12" HorizontalTextAlignment="Center"></Label>
                </VerticalStackLayout>
            </Border>
                        
            <Border BackgroundColor="#2B2B29" Grid.Column="2" Stroke="#4A4A45" 
                    StrokeThickness="1" Padding="12"
                    HeightRequest="78"
                    StrokeShape="RoundRectangle 14">

                <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                    <Label Text="8" TextColor="White" FontSize="22" FontAttributes="Bold" HorizontalTextAlignment="Center"></Label>
                    <Label Text="Pendientes" TextColor="White" FontSize="12" HorizontalTextAlignment="Center"></Label>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <ScrollView Grid.Row="2" BackgroundColor="#0F0F0F">
            <Grid Padding="10" ColumnSpacing="10">
                <Button Text="Cerrar sesión" HeightRequest="50" 
                        CornerRadius="15" BorderWidth="1"
                        BackgroundColor="#2B2B29"
                        FontAttributes="Bold" TextColor="#F54927" BorderColor="#F54927"
                        VerticalOptions="End"
                        Command="{Binding LogoutCommand}">
                </Button>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>