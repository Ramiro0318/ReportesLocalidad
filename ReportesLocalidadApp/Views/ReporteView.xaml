<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ReportesLocalidadApp.Views.ReporteView"
             Title="ReporteView"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*" BackgroundColor="#0F0F0F" Padding="10">
        <Border WidthRequest="38" Grid.Row="0" Grid.Column="0" HeightRequest="38" StrokeShape="RoundRectangle 12"
                BackgroundColor="#2B2B29" Stroke="#4A4A45" Padding="0" VerticalOptions="Center" HorizontalOptions="Start">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding VolverReporteCommand}"></TapGestureRecognizer>
            </Border.GestureRecognizers>
            <Label Grid.Row="0" Text="&lt;" TextColor="White" FontSize="14" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"></Label>
        </Border>

        <Label Text="{Binding ReporteDetalle.Titulo}" TextColor="White" FontSize="20"
               FontAttributes="Bold" HorizontalTextAlignment="Center"
               VerticalTextAlignment="Center"></Label>

        <ScrollView Grid.Row="1" Margin="0,20,0,0">
            <VerticalStackLayout Spacing="10">

                <Border StrokeShape="RoundRectangle 14" BackgroundColor="#2B2B29" Stroke="#4A4A45"
                        HeightRequest="230" Padding="0">
                    <Grid>
                        <Image Source="{Binding ImagenDetalleUrl}" Aspect="AspectFill"></Image>
                        <Label Text="Imagen del reporte" TextColor="LightGray"
                               HorizontalOptions="Center" VerticalOptions="Center"></Label>
                    </Grid>
                </Border>

                <Label Text="Cambiar fotografia" TextColor="White" FontAttributes="Bold" FontSize="15"
                       IsVisible="{Binding EstaEditandoReporte}"></Label>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding EstaEditandoReporte}">
                    <Border Grid.Column="0" Stroke="#4A4A45" StrokeShape="RoundRectangle 10" StrokeThickness="1" StrokeDashArray="4,3" BackgroundColor="#242421" Padding="12" HeightRequest="78">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TomarFotoCommand}"></TapGestureRecognizer>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                            <Label Text="Icono" TextColor="#E6E6C7" FontSize="12" HorizontalTextAlignment="Center"></Label>
                            <Label Text="Camara" TextColor="#E6E6C7" FontSize="12" HorizontalTextAlignment="Center"></Label>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Stroke="#4A4A45" StrokeShape="RoundRectangle 10" StrokeThickness="1" StrokeDashArray="4,3" BackgroundColor="#242421" Padding="12" HeightRequest="78">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SeleccionarFotoCommand}"></TapGestureRecognizer>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                            <Label Text="Icono" TextColor="#E6E6C7" FontSize="12" HorizontalTextAlignment="Center"></Label>
                            <Label Text="Galeria" TextColor="#E6E6C7" FontSize="12" HorizontalTextAlignment="Center"></Label>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border Stroke="#4A4A45" StrokeShape="RoundRectangle 10" StrokeThickness="1" StrokeDashArray="4,3" BackgroundColor="#242421" Padding="12" HeightRequest="160"
                        IsVisible="{Binding EstaEditandoReporte}">
                    <Grid>
                        <Image Source="{Binding ImagenSeleccionada}" Aspect="AspectFill"></Image>
                        <Label Text="Nueva imagen" TextColor="#E6E6C7" FontSize="12" HorizontalTextAlignment="Center"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               IsVisible="{Binding MostrarTextoImagen}"></Label>
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Border BackgroundColor="#FFE9A8" Stroke="Transparent" Padding="10,4"
                            HorizontalOptions="Start" StrokeShape="RoundRectangle 20">
                        <Label Text="{Binding ReporteDetalle.EstadoTexto}" TextColor="#7A5200" FontSize="11"
                               FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"></Label>
                    </Border>

                    <Border Grid.Column="1" BackgroundColor="#FFF1E8" Stroke="Transparent" Padding="10,4"
                            HorizontalOptions="End" StrokeShape="RoundRectangle 20">
                        <Label Text="{Binding ReporteDetalle.CategoriaTexto}" TextColor="#E85B2A" FontSize="11"
                               FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"></Label>
                    </Border>
                </Grid>

                <Label Text="Titulo" TextColor="White" FontSize="15" FontAttributes="Bold"></Label>
                <Border StrokeShape="RoundRectangle 12" BackgroundColor="#2B2B29"
                        Stroke="#4A4A45" Padding="10">
                    <Entry Text="{Binding TituloDetalle}"
                           IsReadOnly="{Binding CamposSoloLectura}"
                           TextColor="White"
                           PlaceholderColor="LightGray"
                           BackgroundColor="Transparent"></Entry>
                </Border>

                <Label Text="Categoria" TextColor="White" FontSize="15" FontAttributes="Bold"></Label>
                <Border StrokeShape="RoundRectangle 12" BackgroundColor="#2B2B29"
                        Stroke="#4A4A45" Padding="10">
                    <Picker ItemsSource="{Binding CategoriasDisponibles}"
                            SelectedItem="{Binding CategoriaDetalle}"
                            IsEnabled="{Binding EstaEditandoReporte}"
                            TextColor="White"
                            BackgroundColor="Transparent"></Picker>
                </Border>

                <Label Text="Ubicacion" TextColor="White" FontSize="15" FontAttributes="Bold"></Label>
                <Border StrokeShape="RoundRectangle 12" BackgroundColor="#2B2B29" Stroke="#4A4A45"
                        Padding="14" HeightRequest="90">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Text="IconoUbicacion" TextColor="#F05A2A"
                               FontSize="15" VerticalOptions="Center"></Label>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="{Binding ReporteDetalle.Direccion}"
                                   TextColor="White" FontSize="13"
                                   FontAttributes="Bold"></Label>

                            <Label Text="Sin direccion registrada" TextColor="LightGray"
                                   FontSize="12"></Label>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Label Text="Descripcion" TextColor="White"
                       FontSize="15" FontAttributes="Bold"></Label>

                <Border StrokeShape="RoundRectangle 12" BackgroundColor="#2B2B29"
                        Stroke="#4A4A45" Padding="14">
                    <Editor Text="{Binding DescripcionDetalle}"
                            IsReadOnly="{Binding CamposSoloLectura}"
                            TextColor="#E6E6E6"
                            BackgroundColor="Transparent"
                            FontSize="13"
                            AutoSize="TextChanges"></Editor>
                </Border>

                <Label Text="{Binding Mensaje}" TextColor="White" FontSize="13"></Label>

                <Button Text="Editar"
                        HeightRequest="50"
                        CornerRadius="15"
                        FontAttributes="Bold"
                        BackgroundColor="#1E4BE3"
                        TextColor="White"
                        IsVisible="{Binding PuedeEditarReporte}"
                        Command="{Binding ActivarEdicionReporteCommand}"></Button>

                <Button Text="Confirmar edicion"
                        HeightRequest="50"
                        CornerRadius="15"
                        FontAttributes="Bold"
                        BackgroundColor="#F54927"
                        TextColor="White"
                        IsVisible="{Binding EstaEditandoReporte}"
                        Command="{Binding GuardarEdicionReporteCommand}"></Button>

                <Button Text="Eliminar"
                        HeightRequest="50"
                        CornerRadius="15"
                        FontAttributes="Bold"
                        BackgroundColor="#FF122E"
                        TextColor="White"
                        IsVisible="{Binding PuedeEditarReporte}"
                        Command="{Binding EliminarReporteCommand}"></Button>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
