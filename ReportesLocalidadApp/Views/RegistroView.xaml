<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ReportesLocalidadApp.Views.RegistroView"
             Title="RegistroView"
             Shell.NavBarIsVisible="False">
    <Grid BackgroundColor="#0F0F0F">
        <Grid.Background>
            <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                <GradientStop Color="#f05a3c" Offset="0.1" />
                <GradientStop Color="#F54927" Offset="0.8" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Spacing="24" Padding="28,60,28,40" VerticalOptions="Center">
                <VerticalStackLayout>
                    <Border WidthRequest="80" HeightRequest="80" Stroke="Transparent" Margin="10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#F2694E" Offset="0" />
                                <GradientStop Color="#F54927" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Image Source="ciudad.png"
                               WidthRequest="60"
                               HeightRequest="60"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <Label Text="Crear cuenta"
                           FontSize="25"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center" />
                    <Label Text="Registra tu cuenta ciudadana"
                           Margin="0,10,0,0"
                           FontSize="15"
                           TextColor="#80FFFFFF"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="USUARIO" FontSize="12" FontAttributes="Bold" TextColor="#80FFFFFF" />
                    <Entry Placeholder="Ej. Carlos"
                           Text="{Binding NombreUsuario}"
                           TextColor="White"
                           PlaceholderColor="#40FFFFFF"
                           HeightRequest="50"
                           BackgroundColor="#14FFFFFF" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="CONTRASENA" FontSize="12" FontAttributes="Bold" TextColor="#80FFFFFF" />
                    <Entry IsPassword="True"
                           Placeholder="********"
                           Text="{Binding Password}"
                           TextColor="White"
                           PlaceholderColor="#40FFFFFF"
                           HeightRequest="50"
                           BackgroundColor="#14FFFFFF" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="CONFIRMAR CONTRASENA" FontSize="12" FontAttributes="Bold" TextColor="#80FFFFFF" />
                    <Entry IsPassword="True"
                           Placeholder="********"
                           Text="{Binding ConfirmarPassword}"
                           TextColor="White"
                           PlaceholderColor="#40FFFFFF"
                           HeightRequest="50"
                           BackgroundColor="#14FFFFFF" />
                </VerticalStackLayout>

                <Label Text="{Binding Mensaje}"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center"
                       LineBreakMode="WordWrap"
                       FontSize="15"
                       TextColor="#90FFFFFF" />

                <Button Text="Registrarme"
                        HeightRequest="50"
                        CornerRadius="15"
                        FontAttributes="Bold"
                        BackgroundColor="#F54927"
                        TextColor="White"
                        Command="{Binding RegistrarCommand}" />

                <Button Text="Ya tengo cuenta"
                        HeightRequest="50"
                        CornerRadius="15"
                        FontAttributes="Bold"
                        BackgroundColor="#2B2B29"
                        TextColor="White"
                        Command="{Binding IrLoginCommand}" />

                <ActivityIndicator IsVisible="{Binding IsBusy}"
                                   IsRunning="{Binding IsBusy}"
                                   Color="White" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
